# =============================================================================
# MindRest_AI — environment template
# =============================================================================
# CARA PAKAI:
#   1. cp .env.example .env
#   2. Edit .env dan ganti nilai placeholder di bawah dengan kredensial asli
#      dari dashboard Supabase (lihat supabase/README.md).
#   3. Rebuild (Gradle tidak auto-reload .env).
#
# JANGAN commit file .env ke git! (sudah di .gitignore)
# =============================================================================

# ---- Gemini AI ------------------------------------------------------------
# API key dari https://aistudio.google.com/apikey
# (Belum dipakai di app saat ini — dependency sudah ada untuk tahap berikutnya.)
GEMINI_API_KEY=MY_GEMINI_API_KEY

# ---- Supabase -------------------------------------------------------------
# Cara dapat URL & anon key:
#   Dashboard Supabase → Project kamu → Settings → API
#     Project URL      → SUPABASE_URL
#     anon / public    → SUPABASE_ANON_KEY
#
# Contoh bentuk:
#   SUPABASE_URL=https://abcdefghij.supabase.co
#   SUPABASE_ANON_KEY=eyJhbGciOi...   (JWT panjang)
# ----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# ---- Google Sign-In (Credential Manager) ---------------------------------
# Web OAuth Client ID dari Google Cloud Console:
#   https://console.cloud.google.com/ → APIs & Services → Credentials
#   → Create credentials → OAuth client ID → Web application
#
# Client ID ini dipakai oleh Android Credential Manager untuk meminta
# ID token dari Google. Tanpa nilai ini, tombol "Continue with Google"
# akan nonaktif.
#
# Wajib pakai tipe **Web application** (bukan Android), karena Android
# Credential Manager butuh server-style audience untuk verifikasi token.
# ----------------------------------------------------------------------------
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
